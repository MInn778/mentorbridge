# Neon(PostgreSQL) 사용 시: Neon 대시보드 > Connect 의 연결 문자열을 그대로 붙여넣기
# 예) postgresql://neondb_owner:비밀번호@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# 이 값이 있으면 아래 DB_URL/DB_USERNAME/DB_PASSWORD는 무시됨
DATABASE_URL=

# 로컬 MySQL DB 접속 정보 (DATABASE_URL을 안 쓸 때 필수)
DB_USERNAME=root
DB_PASSWORD=changeme

# 필요시 DB URL 자체를 덮어쓰고 싶을 때만 설정 (기본값은 application.yml 참고)
# DB_URL=jdbc:mysql://localhost:3306/mentoring_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul

# JWT 서명에 사용하는 secret (필수) - 아래 명령으로 새로 생성 후 사용
# openssl rand -hex 32
JWT_SECRET=changeme
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=1209600000

# 메일 발송용 Gmail 계정 (선택)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# 구글 소셜 로그인 (Google Cloud Console > OAuth 클라이언트 ID)
GOOGLE_CLIENT_ID=changeme
GOOGLE_CLIENT_SECRET=changeme
# 로그인 성공 후 프론트로 돌려보낼 콜백 주소
OAUTH2_REDIRECT_URI=http://localhost:3000/oauth/callback

# 배포된 프론트엔드 주소 (배포 시 필수, 로컬은 비워둠) - CORS 허용용. 예) https://mentorbridge.vercel.app
FRONTEND_URL=

# 공공데이터포털 - 재정경제부_공공기관 채용정보 조회서비스 인증키 (선택 - 없으면 job_cache에 시드 데이터만 표시됨)
# 발급: https://www.data.go.kr/data/15125273/openapi.do 에서 로그인 후 활용신청 (개발계정 자동승인)
# 디코딩된 원본 키를 넣을 것 (코드에서 자체적으로 URL 인코딩함)
PUBLIC_DATA_RECRUIT_API_KEY=

# Google Gemini API 키 (선택 - 없으면 피드백 게시판 AI 피드백 기능이 비활성화됨)
# 발급: https://aistudio.google.com/apikey
# 이름을 GEMINI_API_KEY로 하면 OS에 이미 그 이름의 환경변수가 설정되어 있을 때 .env 값을 덮어쓸 수 있으니 주의
BACKEND_GEMINI_API_KEY=
