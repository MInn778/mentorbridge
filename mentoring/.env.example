# 로컬 MySQL DB 접속 정보 (필수)
DB_USERNAME=root
DB_PASSWORD=changeme

# 필요시 DB URL 자체를 덮어쓰고 싶을 때만 설정 (기본값은 application.yml 참고)
# DB_URL=jdbc:mysql://localhost:3306/mentoring_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul

# JWT 서명에 사용하는 secret (필수) - 아래 명령으로 새로 생성 후 사용
# openssl rand -hex 32
JWT_SECRET=changeme
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=1209600000

# 메일 발송용 Gmail 계정 (선택)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# 구글 소셜 로그인 (Google Cloud Console > OAuth 클라이언트 ID)
GOOGLE_CLIENT_ID=changeme
GOOGLE_CLIENT_SECRET=changeme
# 로그인 성공 후 프론트로 돌려보낼 콜백 주소
OAUTH2_REDIRECT_URI=http://localhost:3000/oauth/callback
